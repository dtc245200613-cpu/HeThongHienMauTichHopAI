@model IEnumerable<HeThongHienMauTichHopAI.Models.Campaign>

@{
    ViewData["Title"] = "Chiến dịch hiến máu";
}

<div class="container mt-5">

    <!-- TIÊU ĐỀ -->
    <div class="text-center mb-5">

        <div style="font-size:60px;">
            🩸
        </div>

        <h1 class="text-danger fw-bold">
            CHIẾN DỊCH HIẾN MÁU
        </h1>

        <p class="text-muted fs-5">
            Danh sách các chiến dịch hiến máu tình nguyện
        </p>

    </div>


    <!-- THANH CHỨC NĂNG -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="fw-bold">
            📅 Danh sách chiến dịch
        </h3>

        <a asp-controller="Campaign"
           asp-action="Create"
           class="btn btn-danger btn-lg">
            ➕ Tạo chiến dịch
        </a>

    </div>


    <!-- DANH SÁCH -->
    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow h-100">

                        <div class="card-body">

                            <div class="text-center mb-3"
                                 style="font-size:45px;">
                                🩸
                            </div>

                            <h4 class="text-danger fw-bold">
                                @item.Name
                            </h4>

                            <hr />

                            <p>
                                📍 <strong>Địa điểm:</strong>
                                @item.Location
                            </p>

                            <p>
                                📅 <strong>Ngày:</strong>
                                @item.Date.ToString("dd/MM/yyyy")
                            </p>

                            <p>
                                👥 <strong>Số lượng:</strong>
                                @item.MaxParticipants người
                            </p>

                            <p>
                                @item.Description
                            </p>

                            <!-- NÚT ĐĂNG KÝ -->
                            <a asp-controller="DonationRegistration"
                               asp-action="Register"
                               asp-route-campaignId="@item.Id"
                               class="btn btn-danger w-100 mt-3">

                                📝 Đăng ký hiến máu

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- CHƯA CÓ CHIẾN DỊCH -->

        <div class="card shadow p-5 text-center">

            <div style="font-size:60px;">
                🩸
            </div>

            <h3 class="mt-3">
                Chưa có chiến dịch
            </h3>

            <p class="text-muted">
                Hiện tại hệ thống chưa có chiến dịch hiến máu nào.
            </p>

            <div class="mt-3">

                <a asp-controller="Campaign"
                   asp-action="Create"
                   class="btn btn-danger btn-lg">

                    ➕ Tạo chiến dịch đầu tiên

                </a>

            </div>

        </div>
    }

</div>