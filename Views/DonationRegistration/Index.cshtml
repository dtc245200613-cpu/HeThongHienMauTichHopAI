@model IEnumerable<HeThongHienMauTichHopAI.Models.DonationRegistration>

@{
    ViewData["Title"] = "Quản lý đăng ký hiến máu";
}

<div class="container mt-5 mb-5">

    <!-- TIÊU ĐỀ -->
    <div class="text-center mb-5">

        <div style="font-size:60px;">
            📋
        </div>

        <h1 class="text-danger fw-bold">
            QUẢN LÝ ĐĂNG KÝ HIẾN MÁU
        </h1>

        <p class="text-muted fs-5">
            Danh sách tình nguyện viên đăng ký hiến máu
        </p>

    </div>


    <!-- THỐNG KÊ -->
    <div class="row g-4 mb-5">

        <!-- TỔNG -->
        <div class="col-md-4">

            <div class="card shadow-sm text-center h-100">

                <div class="card-body p-4">

                    <div class="display-5 fw-bold text-primary">
                        @ViewBag.Total
                    </div>

                    <h5 class="mt-2">
                        Tổng đăng ký
                    </h5>

                </div>

            </div>

        </div>


        <!-- CHỜ DUYỆT -->
        <div class="col-md-4">

            <div class="card shadow-sm text-center h-100">

                <div class="card-body p-4">

                    <div class="display-5 fw-bold text-warning">
                        @ViewBag.Pending
                    </div>

                    <h5 class="mt-2">
                        Chờ duyệt
                    </h5>

                </div>

            </div>

        </div>


        <!-- ĐÃ DUYỆT -->
        <div class="col-md-4">

            <div class="card shadow-sm text-center h-100">

                <div class="card-body p-4">

                    <div class="display-5 fw-bold text-success">
                        @ViewBag.Approved
                    </div>

                    <h5 class="mt-2">
                        Đã duyệt
                    </h5>

                </div>

            </div>

        </div>

    </div>


    <!-- DANH SÁCH -->
    <div class="card shadow border-0">

        <div class="card-header bg-danger text-white p-3">

            <div class="d-flex justify-content-between align-items-center">

                <h4 class="mb-0">
                    📋 Danh sách người đăng ký
                </h4>

                <a asp-action="Register"
                   class="btn btn-light">

                    ➕ Đăng ký mới

                </a>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="text-center">
                                    STT
                                </th>

                                <th>
                                    Họ tên
                                </th>

                                <th>
                                    Nhóm máu
                                </th>

                                <th>
                                    Chiến dịch
                                </th>

                                <th>
                                    Ngày đăng ký
                                </th>

                                <th class="text-center">
                                    Trạng thái
                                </th>

                                <th class="text-center">
                                    Thao tác
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int stt = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-center">
                                        @stt
                                    </td>

                                    <td>
                                        <strong>
                                            @item.VolunteerName
                                        </strong>
                                    </td>

                                    <td>

                                        <span class="badge bg-danger">
                                            @item.BloodType
                                        </span>

                                    </td>

                                    <td>

                                        <span class="text-muted">
                                            Mã chiến dịch:
                                            @item.CampaignId
                                        </span>

                                    </td>

                                    <td>

                                        @item.RegisteredAt
                                            .ToString("dd/MM/yyyy HH:mm")

                                    </td>

                                    <td class="text-center">

                                        @if (item.Status == "Đã duyệt")
                                        {
                                            <span class="badge bg-success">
                                                ✓ Đã duyệt
                                            </span>
                                        }
                                        else if (item.Status == "Từ chối")
                                        {
                                            <span class="badge bg-secondary">
                                                ✕ Từ chối
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                ⏳ Chờ duyệt
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex justify-content-center gap-1">

                                            @if (item.Status == "Chờ duyệt")
                                            {
                                                <form asp-action="Approve"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.Id" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">

                                                        ✓ Duyệt

                                                    </button>

                                                </form>


                                                <form asp-action="Reject"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.Id" />

                                                    <button type="submit"
                                                            class="btn btn-warning btn-sm">

                                                        ✕ Từ chối

                                                    </button>

                                                </form>
                                            }


                                            <form asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa đăng ký này?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">

                                                    🗑

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                                stt++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <div style="font-size:70px;">
                        📋
                    </div>

                    <h3 class="mt-3">
                        Chưa có đăng ký
                    </h3>

                    <p class="text-muted">

                        Hiện tại chưa có tình nguyện viên
                        nào đăng ký.

                    </p>

                    <a asp-action="Register"
                       class="btn btn-danger">

                        ➕ Tạo đăng ký đầu tiên

                    </a>

                </div>
            }

        </div>

    </div>

</div>