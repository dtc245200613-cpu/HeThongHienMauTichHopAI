@{
    ViewData["Title"] = "Đăng ký thành công";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow border-0 text-center">

                <div class="card-body p-5">

                    <div style="font-size:80px;">
                        ✅
                    </div>

                    <h1 class="text-success fw-bold mt-3">
                        ĐĂNG KÝ THÀNH CÔNG
                    </h1>

                    <p class="fs-5 mt-3">
                        Bạn đã đăng ký tham gia
                        chiến dịch hiến máu thành công.
                    </p>

                    <div class="alert alert-warning mt-4">

                        ⏳ Trạng thái đăng ký:

                        <strong>
                            Chờ duyệt
                        </strong>

                    </div>

                    <div class="mt-4">

                        <a asp-controller="Campaign"
                           asp-action="Index"
                           class="btn btn-danger">

                            🩸 Xem chiến dịch

                        </a>

                        <a asp-controller="DonationRegistration"
                           asp-action="Index"
                           class="btn btn-secondary">

                            📋 Xem đăng ký

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>