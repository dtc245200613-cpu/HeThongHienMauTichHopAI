@{
    ViewData["Title"] = "Thống kê hiến máu";
}

<div class="container mt-5 mb-5">

    <!-- TIÊU ĐỀ -->

    <div class="text-center mb-5">

        <div style="font-size:60px;">
            📊
        </div>

        <h1 class="text-danger fw-bold">
            THỐNG KÊ HIẾN MÁU
        </h1>

        <p class="text-muted fs-5">
            Tổng hợp tình hình đăng ký hiến máu
        </p>

    </div>


    <!-- THỐNG KÊ TRẠNG THÁI -->

    <div class="row mb-5">

        <!-- TỔNG -->

        <div class="col-md-3 mb-3">

            <div class="card shadow border-0 text-center h-100">

                <div class="card-body p-4">

                    <div style="font-size:40px;">
                        📋
                    </div>

                    <h5 class="fw-bold mt-2">
                        Tổng đăng ký
                    </h5>

                    <h2 class="text-primary fw-bold">
                        @ViewBag.Total
                    </h2>

                </div>

            </div>

        </div>


        <!-- CHỜ DUYỆT -->

        <div class="col-md-3 mb-3">

            <div class="card shadow border-0 text-center h-100">

                <div class="card-body p-4">

                    <div style="font-size:40px;">
                        ⏳
                    </div>

                    <h5 class="fw-bold mt-2">
                        Chờ duyệt
                    </h5>

                    <h2 class="text-warning fw-bold">
                        @ViewBag.Pending
                    </h2>

                </div>

            </div>

        </div>


        <!-- ĐÃ DUYỆT -->

        <div class="col-md-3 mb-3">

            <div class="card shadow border-0 text-center h-100">

                <div class="card-body p-4">

                    <div style="font-size:40px;">
                        ✅
                    </div>

                    <h5 class="fw-bold mt-2">
                        Đã duyệt
                    </h5>

                    <h2 class="text-success fw-bold">
                        @ViewBag.Approved
                    </h2>

                </div>

            </div>

        </div>


        <!-- TỪ CHỐI -->

        <div class="col-md-3 mb-3">

            <div class="card shadow border-0 text-center h-100">

                <div class="card-body p-4">

                    <div style="font-size:40px;">
                        ❌
                    </div>

                    <h5 class="fw-bold mt-2">
                        Từ chối
                    </h5>

                    <h2 class="text-danger fw-bold">
                        @ViewBag.Rejected
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- THỐNG KÊ NHÓM MÁU -->

    <div class="card shadow border-0">

        <div class="card-header bg-danger text-white">

            <h4 class="mb-0">
                🩸 Thống kê theo nhóm máu
            </h4>

        </div>


        <div class="card-body">

            <div class="row">


                <!-- A+ -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                A+
                            </h3>

                            <h2>
                                @ViewBag.APlus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>


                <!-- A- -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                A-
                            </h3>

                            <h2>
                                @ViewBag.AMinus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>


                <!-- B+ -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                B+
                            </h3>

                            <h2>
                                @ViewBag.BPlus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>


                <!-- B- -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                B-
                            </h3>

                            <h2>
                                @ViewBag.BMinus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>


                <!-- AB+ -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                AB+
                            </h3>

                            <h2>
                                @ViewBag.ABPlus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>


                <!-- AB- -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                AB-
                            </h3>

                            <h2>
                                @ViewBag.ABMinus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>


                <!-- O+ -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                O+
                            </h3>

                            <h2>
                                @ViewBag.OPlus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>


                <!-- O- -->

                <div class="col-md-3 mb-4">

                    <div class="card border shadow-sm text-center">

                        <div class="card-body">

                            <h3 class="text-danger fw-bold">
                                O-
                            </h3>

                            <h2>
                                @ViewBag.OMinus
                            </h2>

                            <p class="text-muted mb-0">
                                người đăng ký
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- NÚT QUAY LẠI -->

    <div class="text-center mt-4">

        <a asp-controller="RegistrationManagement"
           asp-action="Index"
           class="btn btn-secondary">

            ← Quay lại quản lý đăng ký

        </a>

    </div>

</div>