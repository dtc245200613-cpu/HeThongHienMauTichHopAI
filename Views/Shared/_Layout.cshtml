<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Hệ thống hiến máu
    </title>

    <script type="importmap"></script>

    <!-- BOOTSTRAP -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HeThongHienMauTichHopAI.styles.css"
          asp-append-version="true" />

</head>


<body>


    <!-- ============================= -->
    <!-- NAVBAR -->
    <!-- ============================= -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">


                <!-- LOGO -->

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    🩸 HeThongHienMauTichHopAI

                </a>


                <!-- MOBILE BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- MENU -->

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">


                    <!-- MENU BÊN TRÁI -->

                    <ul class="navbar-nav flex-grow-1">


                        <!-- TRANG CHỦ -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                🏠 Trang chủ

                            </a>

                        </li>


                        <!-- CHIẾN DỊCH -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Campaign"
                               asp-action="Index">

                                🩸 Chiến dịch

                            </a>

                        </li>


                        
                        <!-- CHATBOT AI -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="AI"
                               asp-action="Index">

                                🤖 Chatbot AI

                            </a>

                        </li>


                        <!-- QUẢN LÝ ĐĂNG KÝ -->
                        <!-- CHỈ COORDINATOR / ADMIN -->

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             (User.IsInRole("Coordinator") ||
                              User.IsInRole("Admin")))
                        {

                            <li class="nav-item">

                                <a class="nav-link text-danger fw-bold"
                                   asp-controller="RegistrationManagement"
                                   asp-action="Index">

                                    📋 Quản lý đăng ký

                                </a>

                            </li>

                        }

                    </ul>


                    <!-- MENU BÊN PHẢI -->

                    <ul class="navbar-nav">


                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {

                            <!-- TÊN NGƯỜI DÙNG -->

                            <li class="nav-item">

                                <span class="nav-link">

                                    👤 @User.Identity.Name

                                </span>

                            </li>


                            <!-- ROLE -->

                            <li class="nav-item">

                                <span class="nav-link text-danger">

                                    (
                                    @User.FindFirst(
                                        System.Security.Claims.ClaimTypes.Role
                                    )?.Value
                                    )

                                </span>

                            </li>


                            <!-- ĐĂNG XUẤT -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm mt-1">

                                        🚪 Đăng xuất

                                    </button>

                                </form>

                            </li>

                        }
                        else
                        {

                            <!-- ĐĂNG NHẬP -->

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    🔐 Đăng nhập

                                </a>

                            </li>


                            <!-- ĐĂNG KÝ TÀI KHOẢN -->

                            <li class="nav-item">

                                <a class="btn btn-danger btn-sm mt-1"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    📝 Đăng ký

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <!-- ============================= -->
    <!-- NỘI DUNG -->
    <!-- ============================= -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>



    <!-- ============================= -->
    <!-- FOOTER -->
    <!-- ============================= -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Hệ thống quản lý hiến máu tình nguyện -

            <a asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>



    <!-- ============================= -->
    <!-- JAVASCRIPT -->
    <!-- ============================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>